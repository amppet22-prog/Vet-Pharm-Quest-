    "cell-seg": {
      "id": "seg",
      "name": "Segmented neutrophil/ Mature Neutrophil",
      "group": "White cells",
      "look": "Mature lobulated nucleus connected by thin filaments, pale granular cytoplasm. They have condensed chromatin and 2-5 nuclear lobes separated by thin filaments.",
      "meaning": "Mature innate polymorphonuclear cells or PMNs. The immune system's first responders to bacterial infection and inflammation. Assess its absolute count and any toxic changes or concurrent immature cells.",
      "why": "Mature neutrophils circulate before migrating to inflammatory sites; morphology alone does not diagnose bacterial infection.",
